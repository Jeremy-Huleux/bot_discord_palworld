# ============================================================
# BOT DISCORD PALWORLD - Configuration
# ============================================================
# Renommer ce fichier en .env et remplir les valeurs

# ============================================================
# DISCORD
# ============================================================

# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# ID du serveur Discord (Guild ID)
# Pour obtenir: Activer Mode Développeur > Clic droit serveur > Copier l'ID
DISCORD_GUILD_ID=your_guild_id_here

# ============================================================
# SALONS DISCORD (Channel IDs)
# ============================================================

# Salon pour les notes de patch et mises à jour
PATCH_NOTES_CHANNEL_ID=your_patch_notes_channel_id

# Salon pour les actualités générales Palworld
NEWS_CHANNEL_ID=your_news_channel_id

# Salon pour les événements spéciaux
EVENTS_CHANNEL_ID=your_events_channel_id

# ============================================================
# ROLES DISCORD
# ============================================================

# Rôle @Palworld mentionné pour les grandes mises à jour
PALWORLD_ROLE_ID=your_palworld_role_id

# ============================================================
# SERVEUR PALWORLD (Futur)
# ============================================================

# URL de l'API REST du serveur Palworld
# PALWORLD_API_URL=http://your_server_ip:8211

# Clé API du serveur Palworld
# PALWORLD_API_KEY=your_api_key

# ============================================================
# CONFIGURATION BOT
# ============================================================

# Intervalle de vérification des actualités (en secondes)
# NEWS_CHECK_INTERVAL=300

# Mode debug (affiche plus de logs)
# DEBUG_MODE=false

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
