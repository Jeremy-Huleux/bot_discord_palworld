import re
import aiohttp

from bs4 import BeautifulSoup
from urllib.parse import urljoin


POCKETPAIR_URL = (
    "https://www.pocketpair.jp/en/"
    "game-news/category_game/palworld-en/"
)


class PocketpairService:

    def __init__(self, database):
        self.database = database

    async def fetch_article_details(self, session, url):
        """
        Récupère le contenu et l'image principale
        d'un article Pocketpair.
        """

        try:
            async with session.get(
                url,
                timeout=aiohttp.ClientTimeout(total=20)
            ) as response:

                if response.status != 200:
                    print(
                        f"⚠️ Article Pocketpair HTTP "
                        f"{response.status} : {url}"
                    )
                    return "", ""

                html = await response.text()

            soup = BeautifulSoup(
                html,
                "html.parser"
            )

            # -------------------------------------------------
            # IMAGE PRINCIPALE
            # -------------------------------------------------

            image_url = ""

            # OpenGraph : généralement la meilleure source
            og_image = soup.find(
                "meta",
                property="og:image"
            )

            if og_image and og_image.get("content"):
                image_url = urljoin(
                    url,
                    og_image["content"]
                )

            # Fallback : première image de l'article
            if not image_url:

                article = soup.find(
                    "article"
                )

                if article:

                    img = article.find(
                        "img"
                    )

                    if img and img.get("src"):

                        image_url = urljoin(
                            url,
                            img["src"]
                        )

            # -------------------------------------------------
            # CONTENU
            # -------------------------------------------------

            article = soup.find(
                "article"
            )

            if not article:

                # Fallbacks possibles du site
                article = (
                    soup.find(
                        class_=re.compile(
                            r"entry-content|post-content|article-content",
                            re.IGNORECASE
                        )
                    )
                )

            if not article:
                return "", image_url

            # Supprimer les éléments inutiles
            for element in article.find_all(
                [
                    "script",
                    "style",
                    "nav",
                    "footer",
                    "form"
                ]
            ):
                element.decompose()

            text = article.get_text(
                separator=" ",
                strip=True
            )

            # Nettoyage
            text = re.sub(
                r"\s+",
                " ",
                text
            ).strip()

            # -------------------------------------------------
            # RESUME
            # -------------------------------------------------

            # Discord Embed.description max = 4096 caractères.
            # On garde un extrait raisonnable.
            if len(text) > 700:
                summary = text[:700].rsplit(
                    " ",
                    1
                )[0] + "..."
            else:
                summary = text

            return summary, image_url

        except Exception as error:

            print(
                f"⚠️ Erreur détails Pocketpair "
                f"{url} : {error}"
            )

            return "", ""

    async def fetch_news(self):

        results = []

        headers = {
            "User-Agent": (
                "Mozilla/5.0 "
                "(compatible; ZaelosPalworldBot/1.0)"
            )
        }

        try:

            async with aiohttp.ClientSession(
                headers=headers
            ) as session:

                # =================================================
                # PAGE LISTE POCKETPAIR
                # =================================================

                async with session.get(
                    POCKETPAIR_URL,
                    timeout=aiohttp.ClientTimeout(total=20)
                ) as response:

                    if response.status != 200:

                        print(
                            f"❌ Pocketpair HTTP "
                            f"{response.status}"
                        )

                        return results

                    html = await response.text()

                soup = BeautifulSoup(
                    html,
                    "html.parser"
                )

                # =================================================
                # RECHERCHE DES ARTICLES
                # =================================================

                seen_urls = set()

                for link in soup.find_all(
                    "a",
                    href=True
                ):

                    href = link.get(
                        "href",
                        ""
                    )

                    url = urljoin(
                        POCKETPAIR_URL,
                        href
                    )

                    # Un vrai article doit être
                    # sous /game-news/
                    if "/game-news/" not in url:
                        continue

                    # Ne pas prendre la page principale
                    if url.rstrip("/") == (
                        "https://www.pocketpair.jp/en/game-news"
                    ):
                        continue

                    # Ne pas prendre les pages catégories
                    if "category_game" in url:
                        continue

                    if url in seen_urls:
                        continue

                    seen_urls.add(url)

                    # =================================================
                    # TITRE
                    # =================================================

                    raw_title = link.get_text(
                        " ",
                        strip=True
                    )

                    if not raw_title:
                        continue

                    # Navigation
                    if raw_title.lower() in {
                        "game news",
                        "all",
                        "palworld",
                        "palworld: palfarm"
                    }:
                        continue

                    # =================================================
                    # DATE
                    # =================================================

                    date_match = re.search(
                        r"\b(20\d{2}\.\d{2}\.\d{2})\b",
                        raw_title
                    )

                    published = ""

                    if date_match:
                        published = date_match.group(1)

                    # =================================================
                    # CATEGORIE
                    # =================================================

                    category = "Palworld"

                    lowered = raw_title.lower()

                    if "important notice" in lowered:

                        category = "important notice"

                    elif "event information" in lowered:

                        category = "Event Information"

                    elif "pitch your game" in lowered:

                        category = "Pitch Your Game"

                    elif re.search(
                        r"\bupdate\b",
                        lowered
                    ):

                        category = "update"

                    elif re.search(
                        r"\bnews\b",
                        lowered
                    ):

                        category = "News"

                    # =================================================
                    # NETTOYAGE TITRE
                    # =================================================

                    title = raw_title

                    prefixes = [
                        "important notice",
                        "event information",
                        "pitch your game",
                        "update",
                        "news",
                        "palworld"
                    ]

                    for prefix in prefixes:

                        title = re.sub(
                            rf"^\s*{re.escape(prefix)}\s*",
                            "",
                            title,
                            flags=re.IGNORECASE
                        )

                    if published:

                        title = title.replace(
                            published,
                            "",
                            1
                        )

                    title = re.sub(
                        r"\s+",
                        " ",
                        title
                    ).strip()

                    title = title.strip(
                        ":-–—| "
                    )

                    if not title:
                        continue

                    # Pitch Your Game ignoré
                    if category == "Pitch Your Game":
                        continue

                    # =================================================
                    # GUID
                    # =================================================

                    guid = (
                        f"pocketpair:{url}"
                    )

                    if self.database.news_exists(
                        guid
                    ):
                        continue

                    # =================================================
                    # DETAILS ARTICLE
                    # =================================================

                    summary, image_url = (
                        await self.fetch_article_details(
                            session,
                            url
                        )
                    )

                    # =================================================
                    # RESULTAT
                    # =================================================

                    results.append(
                        {
                            "guid": guid,
                            "title": title,
                            "summary": summary,
                            "image": image_url,
                            "url": url,
                            "published": published,
                            "source": "Pocketpair",
                            "category": category
                        }
                    )

        except Exception as error:

            print(
                f"❌ Erreur Pocketpair : {error}"
            )

        return results
